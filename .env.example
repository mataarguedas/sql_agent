# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# PostgreSQL — admin role (used only for db/init: DDL, seed, role creation)
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/northwind

# PostgreSQL — read-only role (used by the agent at runtime)
DATABASE_READONLY_URL=postgresql+psycopg://sql_agent_ro:readonly@localhost:5432/northwind

# Execution guardrails
QUERY_ROW_LIMIT=1000
QUERY_STATEMENT_TIMEOUT_MS=10000

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=sql-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
